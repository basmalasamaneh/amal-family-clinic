modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "seed-baseline"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "seed-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "operational-integrity"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "workspace-typecheck"

[[workflows.workflow]]
name = "seed-baseline"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts seed:verify"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "seed-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck:libs && pnpm --filter @workspace/scripts typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "operational-integrity"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts operational:test --demo"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "workspace-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
AUTH_ALLOWED_ORIGINS = "https://bf3e32dc-54d0-4d6f-8c18-82dda6dba30b-00-2b6qfmcqqsbep-bxlkcqsd.reed.replit.dev"
