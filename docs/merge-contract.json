{
  "paths": {
    "/patients/duplicates": {
      "get": {
        "operationId": "listPatientDuplicates",
        "tags": ["Patients"],
        "x-roles": ["doctor", "front-desk"],
        "security": [{"sessionCookie": []}],
        "description": "Scoped before exact normalized-name, date-only DOB and canonical-phone comparison; all three required. Doctors additionally require trusted doctor grants. Candidates are not merge authorization. Ascending ID pairs; cursor binds actor and scope.",
        "parameters": [
          {"in":"query","name":"limit","schema":{"type":"integer","minimum":1,"maximum":100,"default":25}},
          {"in":"query","name":"cursor","schema":{"type":"string","maxLength":512}}
        ],
        "responses": {
          "200": {"description":"Current candidates","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PatientDuplicates"},"example":{"items":[],"nextCursor":null}}}},
          "400": {"description":"Invalid request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiFailure"},"example":{"code":"VALIDATION","messageKey":"error.validation","params":{}}}}},
          "401": {"description":"Sign in required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiFailure"},"example":{"code":"UNAUTHORIZED","messageKey":"error.unauthorized","params":{}}}}},
          "403": {"description":"Scope denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiFailure"},"example":{"code":"FORBIDDEN","messageKey":"error.forbidden","params":{}}}}}
        }
      }
    },
    "/patients/merge": {
      "post": {
        "operationId": "mergePatients",
        "tags": ["Patients"],
        "x-roles": ["doctor", "front-desk"],
        "security": [{"sessionCookie":[],"csrfToken":[]}],
        "description": "Explicit selection and confirmation only. Revalidates authorization, exact identity and versions under consent and booking locks. Rejects any consent evidence, different visibility grants, aliases/chains, import references, active holds, patient overlaps and unknown references. Preserves source tombstone, immutable audit IDs and move provenance. Durable actor-bound idempotency; replay reauthorizes.",
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PatientMergeRequest"},"example":{"sourceId":900001,"targetId":900002,"sourceVersion":1,"targetVersion":1,"confirmed":true,"reason":"Duplicate registration reviewed","clientOpId":"573f53e0-5b66-4a2e-b979-7002f63ca5ad"}}}},
        "responses":{
          "200":{"description":"Durable merge receipt","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PatientMergeResult"},"example":{"sourceId":900001,"targetId":900002,"sourceVersion":2,"targetVersion":2,"mergedAt":"2026-01-01T12:00:00.000Z"}}}},
          "400":{"description":"Invalid request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiFailure"},"example":{"code":"VALIDATION","messageKey":"error.validation","params":{}}}}},
          "401":{"description":"Sign in required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiFailure"},"example":{"code":"UNAUTHORIZED","messageKey":"error.unauthorized","params":{}}}}},
          "403":{"description":"Scope denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiFailure"},"example":{"code":"FORBIDDEN","messageKey":"error.forbidden","params":{}}}}},
          "404":{"description":"Patient not found in scope","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiFailure"},"example":{"code":"NOT_FOUND","messageKey":"error.notFound","params":{}}}}},
          "409":{"description":"Stale versions, unsafe references, consent, visibility or idempotency collision","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiFailure"},"example":{"code":"MERGE_UNSAFE","messageKey":"error.conflict","params":{}}}}}
        }
      }
    }
  },
  "components":{"schemas":{
    "DuplicatePatient":{"type":"object","additionalProperties":false,"required":["id","name","version"],"properties":{"id":{"type":"integer","minimum":1},"name":{"type":"string"},"version":{"type":"integer","minimum":1}}},
    "PatientDuplicatePair":{"type":"object","additionalProperties":false,"required":["source","target"],"properties":{"source":{"$ref":"#/components/schemas/DuplicatePatient"},"target":{"$ref":"#/components/schemas/DuplicatePatient"}}},
    "PatientDuplicates":{"type":"object","additionalProperties":false,"required":["items","nextCursor"],"properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/PatientDuplicatePair"}},"nextCursor":{"type":["string","null"]}}},
    "PatientMergeRequest":{"type":"object","additionalProperties":false,"required":["sourceId","targetId","sourceVersion","targetVersion","confirmed","reason","clientOpId"],"properties":{"sourceId":{"type":"integer","minimum":1,"maximum":2147483647},"targetId":{"type":"integer","minimum":1,"maximum":2147483647},"sourceVersion":{"type":"integer","minimum":1,"maximum":2147483647},"targetVersion":{"type":"integer","minimum":1,"maximum":2147483647},"confirmed":{"type":"boolean","const":true},"reason":{"type":"string","minLength":1,"maxLength":1000},"clientOpId":{"type":"string","format":"uuid"}}},
    "PatientMergeResult":{"type":"object","additionalProperties":false,"required":["sourceId","targetId","sourceVersion","targetVersion","mergedAt"],"properties":{"sourceId":{"type":"integer"},"targetId":{"type":"integer"},"sourceVersion":{"type":"integer"},"targetVersion":{"type":"integer"},"mergedAt":{"type":"string","format":"date-time"}}}
  }}
}
