{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.privacy.json --noEmit",
    "auth:migrate": "tsx scripts/auth-migrate.ts",
    "adoption:migrate": "tsx scripts/adoption-migrate.ts",
    "adoption:test": "tsx --test --test-concurrency=1 tests/adoption*.test.ts",
    "admin:migrate": "tsx scripts/admin-migrate.ts && tsx scripts/network-health-migrate.ts",
    "admin:test": "tsx --test --test-concurrency=1 tests/admin-users.test.ts tests/admin-directory.test.ts tests/network-health.test.ts",
    "appointments:migrate": "tsx scripts/appointments-migrate.ts",
    "appointments:test": "tsx --test tests/appointments-api.test.ts",
    "sync:migrate": "tsx scripts/sync-migrate.ts",
    "sync:test": "tsx --test --test-concurrency=1 tests/sync-api.test.ts",
    "kpis:migrate": "tsx scripts/kpis-migrate.ts",
    "kpis:refresh": "tsx scripts/kpis-refresh.ts",
    "kpis:test": "tsx --test --test-concurrency=1 tests/kpis*.test.ts",
    "patients:migrate": "tsx scripts/patients-migrate.ts",
    "imports:migrate": "tsx scripts/imports-migrate.ts",
    "merge:migrate": "tsx scripts/merge-migrate.ts",
    "imports:test": "tsx --test --test-concurrency=1 tests/import*.test.ts",
    "merge:test": "tsx --test --test-concurrency=1 tests/merge*.test.ts",
    "consent:migrate": "tsx scripts/consent-migrate.ts",
    "consent:test": "tsx --test tests/consent-policy.test.ts tests/consent-api.test.ts",
    "privacy:test": "tsx --test --test-concurrency=1 tests/privacy-api.test.ts tests/consent-policy.test.ts",
    "alerts:migrate": "tsx scripts/alerts-migrate.ts",
    "alerts:extract": "tsx scripts/alerts-extract.ts",
    "alerts:test": "tsx --test --test-concurrency=1 tests/alerts.test.ts tests/alerts-db.test.ts tests/alerts-lifecycle.test.ts",
    "patients:test": "tsx --test tests/demographics.test.ts tests/patient-search.test.ts tests/patients-api.test.ts",
    "auth:test": "tsx --test tests/auth.test.ts",
    "auth:browser": "tsx scripts/login-browser-test.ts",
    "mock": "node src/mock/server.mjs",
    "test:contract": "node --test test/contract-mock.test.mjs"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "zod": "catalog:",
    "pg": "^8.23.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "tsx": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
